@model GerenciamentoCliente.Application.Clientes.ClienteExcluirViewModel

@{
    ViewData["Title"] = "Excluir Cliente";
}

@section PageHeader {
    <div class="row mb-2">
        <div class="col-sm-6">
            <h3 class="m-0">Excluir Cliente</h3>
        </div>
        <div class="col-sm-6">
            <ol class="breadcrumb float-sm-end">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Clientes</a></li>
                <li class="breadcrumb-item active">Excluir</li>
            </ol>
        </div>
    </div>
}

<div class="row">
    <div class="col-md-5">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h3 class="card-title mb-0">
                    <i class="fas fa-exclamation-triangle me-2"></i>Confirmar Exclusão
                </h3>
            </div>
            <div class="card-body">
                <p class="text-muted">Tem certeza que deseja excluir o cliente abaixo?</p>
                <dl class="row">
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.NomeCompleto)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.NomeCompleto)</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Cpf)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Cpf)</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Email)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Email)</dd>
                </dl>
            </div>
            <div class="card-footer d-flex gap-2">
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id"/>
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash me-1"></i> Confirmar Exclusão
                    </button>
                </form>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-1"></i> Cancelar
                </a>
            </div>
        </div>
    </div>
</div>

@model ClientePaginacaoViewModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-6">
        <input type="text"
               name="consulta"
               value="@Model.Consulta"
               class="form-control"
               placeholder="Pesquisar por nome ou CPF"/>
    </div>
    <div class="col-auto">
        <input type="hidden" name="page" value="1"/>
        <input type="hidden" name="pageSize" value="@Model.TamanhoPagina"/>
        <button type="submit" class="btn btn-primary">Pesquisar</button>
    </div>
</form>

<table class="table">
    <thead>
    <tr>
        <th>Nome Completo</th>
        <th>CPF</th>
        <th>Nascimento</th>
        <th>Email</th>
        <th>Telefone</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Itens)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.NomeCompleto)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Cpf)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Nascimento)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Telefone)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>

<div class="d-flex justify-content-between align-items-center">
    <span>Pagina @Model.Pagina de @(Model.TotalPages == 0 ? 1 : Model.TotalPages)</span>
    <div>
        <a asp-action="Index"
           asp-route-page="@(Model.Pagina - 1)"
           asp-route-pageSize="@Model.TamanhoPagina"
           asp-route-searchTerm="@Model.Consulta"
           class="btn btn-outline-secondary @(Model.Pagina <= 1 ? "disabled" : "")">Anterior</a>
        <a asp-action="Index"
           asp-route-page="@(Model.Pagina + 1)"
           asp-route-pageSize="@Model.TamanhoPagina"
           asp-route-searchTerm="@Model.Consulta"
           class="btn btn-outline-secondary @(Model.TotalPages > 0 && Model.Pagina >= Model.TotalPages ? "disabled" : "")">Proxima</a>
    </div>
</div>


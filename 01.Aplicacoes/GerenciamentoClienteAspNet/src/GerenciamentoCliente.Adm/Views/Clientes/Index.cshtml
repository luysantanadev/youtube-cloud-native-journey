@model GerenciamentoCliente.Adm.Models.ViewModels.ClientePaginacaoViewModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
    <tr>
        <th>Nome Completo</th>
        <th>CPF</th>
        <th>Nascimento</th>
        <th>Email</th>
        <th>Telefone</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Itens)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.NomeCompleto)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Cpf)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Nascimento)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Telefone)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>

<div class="d-flex justify-content-between align-items-center">
    <span>Pagina @Model.Page de @(Model.TotalPages == 0 ? 1 : Model.TotalPages)</span>
    <div>
        <a asp-action="Index"
           asp-route-page="@(Model.Page - 1)"
           asp-route-pageSize="@Model.PageSize"
           class="btn btn-outline-secondary @(Model.Page <= 1 ? "disabled" : "")">Anterior</a>
        <a asp-action="Index"
           asp-route-page="@(Model.Page + 1)"
           asp-route-pageSize="@Model.PageSize"
           class="btn btn-outline-secondary @(Model.TotalPages > 0 && Model.Page >= Model.TotalPages ? "disabled" : "")">Proxima</a>
    </div>
</div>


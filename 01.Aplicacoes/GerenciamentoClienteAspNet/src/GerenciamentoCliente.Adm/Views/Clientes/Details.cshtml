@model GerenciamentoCliente.Application.Clientes.ClienteDetalhesViewModel

@{
    ViewData["Title"] = "Detalhes do Cliente";
}

@section PageHeader {
    <div class="row mb-2">
        <div class="col-sm-6">
            <h3 class="m-0">Detalhes do Cliente</h3>
        </div>
        <div class="col-sm-6">
            <ol class="breadcrumb float-sm-end">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Clientes</a></li>
                <li class="breadcrumb-item active">Detalhes</li>
            </ol>
        </div>
    </div>
}

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-user me-2"></i>Dados do Cliente</h3>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.NomeCompleto)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.NomeCompleto)</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Cpf)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Cpf)</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Nascimento)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Nascimento)</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Email)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Email)</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Telefone)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Telefone)</dd>
                </dl>
            </div>
            <div class="card-footer d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm">
                    <i class="fas fa-edit me-1"></i> Editar
                </a>
                <a asp-action="Index" class="btn btn-secondary btn-sm">
                    <i class="fas fa-arrow-left me-1"></i> Voltar
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-map-marker-alt me-2"></i>Endereços</h3>
            </div>
            <div class="card-body p-0">
                @if (Model.Enderecos.Count > 0)
                {
                    <table class="table table-striped table-hover mb-0">
                        <thead class="table-dark">
                        <tr>
                            <th>Logradouro</th>
                            <th>Número</th>
                            <th>Bairro</th>
                            <th>CEP</th>
                            <th>Cidade</th>
                            <th>UF</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var endereco in Model.Enderecos)
                        {
                            <tr>
                                <td>@endereco.Logradouro</td>
                                <td>@endereco.Numero</td>
                                <td>@endereco.Bairro</td>
                                <td>@endereco.Cep</td>
                                <td>@endereco.CidadeNome</td>
                                <td>@endereco.EstadoSigla</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="p-3">
                        <p class="text-muted mb-0">
                            <i class="fas fa-info-circle me-1"></i> Cliente sem endereços cadastrados.
                        </p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - GerenciamentoCliente.Adm</title>
    <script type="importmap">
    {
        "imports": {
            "bootstrap": "https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.esm.min.js",
            "admin-lte": "https://cdn.jsdelivr.net/npm/admin-lte@4.0.0/dist/js/adminlte.min.js",
            "overlayscrollbars": "https://cdn.jsdelivr.net/npm/overlayscrollbars@1.13.1/js/OverlayScrollbars.esm.js",
            "jquery": "https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"
        }
    }
    </script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css"
          crossorigin="anonymous"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
          crossorigin="anonymous"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/overlayscrollbars@1.13.1/css/OverlayScrollbars.min.css"
          crossorigin="anonymous"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0/dist/css/adminlte.min.css"
          crossorigin="anonymous"/>
    @await RenderSectionAsync("Styles", required: false)
</head>
    <body class="hold-transition sidebar-mini layout-fixed" data-context7-root="true">
    <div id="context7-wrapper" class="wrapper">
        @await Html.PartialAsync("_Navbar")

        <!-- Main Sidebar Container -->
        @await Html.PartialAsync("_Sidebar")
        <!-- Content Wrapper. Contains page content -->
        <main id="context7-content" class="content-wrapper">
            <section class="content-header">
                <div class="container-fluid">
                    @await RenderSectionAsync("PageHeader", required: false)
                </div>
            </section>

            <section class="content">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </section>
        </main>

        @await Html.PartialAsync("_Footer")
        <!-- Control Sidebar -->
        <aside class="control-sidebar control-sidebar-dark">
            <!-- Control sidebar content goes here -->
        </aside>
    </div> <!-- ./wrapper -->
    <script type="module">
        // Load modules using importmap (Context7-compliant)
        import "jquery";
        import "overlayscrollbars";
        import "bootstrap";
        import "admin-lte";

        // Initialize OverlayScrollbars when DOM is ready
        document.addEventListener('DOMContentLoaded', function () {
            if (typeof OverlayScrollbars !== 'undefined') {
                OverlayScrollbars(document.querySelectorAll('body'), {});
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>